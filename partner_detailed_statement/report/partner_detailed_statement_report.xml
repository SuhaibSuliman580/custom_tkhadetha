<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="statement">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page" t-att-dir="'rtl' if is_arabic else 'ltr'">
                    <style>
                        .partner-statement {
                            color: #1f2933;
                            font-size: 12px;
                            font-family: "DejaVu Sans", "Tahoma", "Arial", sans-serif;
                        }
                        .partner-statement .statement-header {
                            background: #0f4c5c;
                            color: #ffffff;
                            padding: 18px 20px;
                            border-radius: 6px;
                            margin-bottom: 14px;
                        }
                        .partner-statement .statement-title {
                            margin: 0;
                            font-size: 26px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        .partner-statement .statement-meta {
                            border: 1px solid #d7e3e7;
                            background: #f6fafb;
                            padding: 10px 12px;
                            min-height: 62px;
                            border-radius: 4px;
                        }
                        .partner-statement .statement-meta p {
                            margin: 4px 0 0;
                        }
                        .partner-statement .statement-meta strong,
                        .partner-statement .summary-table strong {
                            color: #0f4c5c;
                        }
                        .partner-statement .partner-name {
                            margin: 16px 0 8px;
                            padding: 8px 12px;
                            color: #0f4c5c;
                            background: #eaf4f6;
                            border-left: 4px solid #0f4c5c;
                            border-radius: 4px;
                            font-size: 18px;
                            font-weight: 700;
                        }
                        .partner-statement[dir="rtl"] .partner-name {
                            border-left: 0;
                            border-right: 4px solid #0f4c5c;
                        }
                        .partner-statement table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 10px;
                            table-layout: fixed;
                        }
                        .partner-statement .meta-grid {
                            border-collapse: separate;
                            border-spacing: 8px 0;
                            table-layout: fixed;
                        }
                        .partner-statement .meta-grid td {
                            border: 0;
                            padding: 0;
                            width: 25%;
                        }
                        .partner-statement th {
                            background: #dbeafe;
                            color: #17324d;
                            border: 1px solid #b9d2ea;
                            padding: 6px 7px;
                            font-weight: 700;
                        }
                        .partner-statement td {
                            border: 1px solid #d9e2e8;
                            padding: 6px 7px;
                            vertical-align: top;
                            word-wrap: break-word;
                            overflow-wrap: break-word;
                        }
                        .partner-statement .bidi-text {
                            unicode-bidi: embed;
                        }
                        .partner-statement .amount-cell,
                        .partner-statement .date-cell,
                        .partner-statement .code-cell {
                            direction: ltr;
                            unicode-bidi: isolate;
                            white-space: nowrap;
                        }
                        .partner-statement .summary-table td {
                            background: #f8fbfc;
                            font-size: 13px;
                        }
                        .partner-statement .movement-table {
                            border-top: 3px solid #0f4c5c;
                            margin-top: 13px;
                        }
                        .partner-statement .movement-table tbody tr {
                            background: #ffffff;
                        }
                        .partner-statement .movement-card {
                            border: 1px solid #cfe0e6;
                            border-top: 3px solid #0f4c5c;
                            border-radius: 5px;
                            margin: 13px 0 10px;
                            page-break-inside: avoid;
                            background: #ffffff;
                        }
                        .partner-statement .movement-card-title {
                            background: #eaf4f6;
                            color: #0f4c5c;
                            padding: 8px 10px;
                            font-size: 14px;
                            font-weight: 700;
                        }
                        .partner-statement .movement-card-body {
                            padding: 8px 10px 2px;
                        }
                        .partner-statement .kv-table {
                            table-layout: fixed;
                            margin-bottom: 8px;
                        }
                        .partner-statement .kv-table td {
                            background: #f8fbfc;
                            width: 25%;
                        }
                        .partner-statement .kv-table strong {
                            color: #0f4c5c;
                            display: block;
                            margin-bottom: 3px;
                        }
                        .partner-statement .line-card {
                            border: 1px solid #badbcc;
                            background: #fbfffd;
                            margin: 7px 0;
                            padding: 7px 9px;
                            page-break-inside: avoid;
                        }
                        .partner-statement .line-name {
                            color: #14532d;
                            font-weight: 700;
                            margin-bottom: 6px;
                        }
                        .partner-statement .mini-kv {
                            table-layout: fixed;
                            margin-bottom: 0;
                        }
                        .partner-statement .mini-kv td {
                            width: 25%;
                            background: #ffffff;
                        }
                        .partner-statement .invoice-summary td {
                            background: #f0f9ff;
                        }
                        .partner-statement .lines-table th {
                            background: #ecfdf5;
                            border-color: #badbcc;
                            color: #14532d;
                        }
                        .partner-statement .empty-line {
                            color: #6b7280;
                            font-style: italic;
                        }
                        .partner-statement .text-end {
                            white-space: nowrap;
                            text-align: right;
                        }
                        .partner-statement[dir="rtl"] .text-end {
                            text-align: left;
                        }
                    </style>

                    <div class="partner-statement" t-att-dir="'rtl' if is_arabic else 'ltr'">
                    <div class="statement-header">
                        <h2 class="statement-title" t-esc="labels['title']"/>
                    </div>

                    <table class="meta-grid">
                        <tbody>
                            <tr>
                                <td>
                            <div class="statement-meta">
                                <strong t-esc="labels['company']"/>
                                <p class="bidi-text" dir="auto" t-esc="res_company.name"/>
                            </div>
                                </td>
                                <td>
                            <div class="statement-meta">
                                <t t-if="data['form']['date_from']">
                                    <strong t-esc="labels['date_from']"/>
                                    <span class="date-cell" t-esc="data['form']['date_from']"/>
                                    <br/>
                                </t>
                                <t t-if="data['form']['date_to']">
                                    <strong t-esc="labels['date_to']"/>
                                    <span class="date-cell" t-esc="data['form']['date_to']"/>
                                </t>
                            </div>
                                </td>
                                <td>
                            <div class="statement-meta">
                                <strong t-esc="labels['partners']"/>
                                <p t-if="data['form']['result_selection'] == 'customer'" t-esc="labels['customers']"/>
                                <p t-if="data['form']['result_selection'] == 'supplier'" t-esc="labels['vendors']"/>
                                <p t-if="data['form']['result_selection'] == 'customer_supplier'" t-esc="labels['customers_vendors']"/>
                            </div>
                                </td>
                                <td>
                            <div class="statement-meta">
                                <strong t-esc="labels['target_moves']"/>
                                <p t-if="data['form']['target_move'] == 'all'" t-esc="labels['all_entries']"/>
                                <p t-if="data['form']['target_move'] == 'posted'" t-esc="labels['posted_entries']"/>
                            </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <t t-foreach="docs" t-as="partner">
                        <t t-set="statement" t-value="statements[partner.id]"/>
                        <h4 class="partner-name">
                            <span t-esc="partner.ref"/>
                            <t t-if="partner.ref"> - </t>
                            <span class="bidi-text" dir="auto" t-esc="partner.name"/>
                        </h4>

                        <table class="table table-sm table-bordered summary-table">
                            <tbody>
                                <tr>
                                    <td><strong t-esc="labels['opening_balance']"/></td>
                                    <td class="text-end">
                                        <span class="amount-cell" t-esc="statement['opening_balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                    <td><strong t-esc="labels['ending_balance']"/></td>
                                    <td class="text-end">
                                        <span class="amount-cell" t-esc="statement['ending_balance']"
                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="not statement['rows']">
                            <p t-esc="labels['no_movements']"/>
                        </t>

                        <t t-foreach="statement['rows']" t-as="row">
                            <t t-if="is_arabic">
                                <div class="movement-card">
                                    <div class="movement-card-title">
                                        <span class="code-cell" t-if="row['invoice']" t-esc="row['invoice'].name"/>
                                        <span class="code-cell" t-if="not row['invoice']" t-esc="row['line'].move_id.name"/>
                                    </div>
                                    <div class="movement-card-body">
                                        <p class="bidi-text" dir="auto">
                                            <span t-if="row['line'].ref" t-esc="row['line'].ref"/>
                                            <t t-if="row['line'].ref and row['line'].name"> - </t>
                                            <span t-esc="row['line'].name"/>
                                        </p>
                                        <table class="kv-table">
                                            <tbody>
                                                <tr>
                                                    <td>
                                                        <strong t-esc="labels['date']"/>
                                                        <span class="date-cell" t-esc="row['date']"/>
                                                    </td>
                                                    <td>
                                                        <strong t-esc="labels['journal']"/>
                                                        <span class="code-cell" t-esc="row['line'].journal_id.code"/>
                                                    </td>
                                                    <td colspan="2">
                                                        <strong t-esc="labels['account']"/>
                                                        <span class="amount-cell" t-esc="row['line'].account_id.code"/>
                                                        <t t-if="row['line'].account_id.code and row['line'].account_id.name"> - </t>
                                                        <span class="bidi-text" dir="rtl" t-esc="row['line'].account_id.name"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        <strong t-esc="labels['debit']"/>
                                                        <span class="amount-cell" t-esc="row['debit']"
                                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                    </td>
                                                    <td>
                                                        <strong t-esc="labels['credit']"/>
                                                        <span class="amount-cell" t-esc="row['credit']"
                                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                    </td>
                                                    <td colspan="2">
                                                        <strong t-esc="labels['balance_after']"/>
                                                        <span class="amount-cell" t-esc="row['invoice_balance']"
                                                              t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                        <t t-if="row['invoice'] and data['form']['include_invoice_lines']">
                                            <table class="kv-table invoice-summary">
                                                <tbody>
                                                    <tr>
                                                        <td>
                                                            <strong t-esc="labels['invoice_total']"/>
                                                            <span class="amount-cell" t-esc="row['invoice'].amount_total"
                                                                  t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                                        </td>
                                                        <td>
                                                            <strong t-esc="labels['residual']"/>
                                                            <span class="amount-cell" t-esc="row['invoice'].amount_residual"
                                                                  t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                                        </td>
                                                        <td colspan="2">
                                                            <strong t-esc="labels['payment_status']"/>
                                                            <span class="bidi-text" dir="auto" t-esc="row['invoice'].payment_state"/>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                            <div t-if="not row['lines']" class="empty-line" t-esc="labels['no_invoice_lines']"/>
                                            <div t-foreach="row['lines']" t-as="line" class="line-card">
                                                <div class="line-name">
                                                    <span class="bidi-text" dir="rtl" t-esc="line['name']"/>
                                                </div>
                                                <table class="mini-kv">
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <strong t-esc="labels['quantity']"/>
                                                                <span class="amount-cell" t-esc="line['quantity']"/>
                                                            </td>
                                                            <td>
                                                                <strong t-esc="labels['unit']"/>
                                                                <span class="bidi-text" dir="rtl" t-esc="line['uom']"/>
                                                            </td>
                                                            <td>
                                                                <strong t-esc="labels['unit_price']"/>
                                                                <span class="amount-cell" t-esc="line['price_unit']"
                                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                                            </td>
                                                            <td>
                                                                <strong t-esc="labels['subtotal']"/>
                                                                <span class="amount-cell" t-esc="line['subtotal']"
                                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <t t-if="not is_arabic">
                            <table class="table table-sm table-reports mt-2 movement-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;" t-esc="labels['movement']"/>
                                        <th style="width: 12%;" t-esc="labels['date']"/>
                                        <th style="width: 9%;" t-esc="labels['journal']"/>
                                        <th style="width: 22%;" t-esc="labels['account']"/>
                                        <th class="text-end" style="width: 10%;" t-esc="labels['debit']"/>
                                        <th class="text-end" style="width: 10%;" t-esc="labels['credit']"/>
                                        <th class="text-end" style="width: 12%;" t-esc="labels['balance_after']"/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <strong class="code-cell" t-if="row['invoice']" t-esc="row['invoice'].name"/>
                                            <strong class="code-cell" t-if="not row['invoice']" t-esc="row['line'].move_id.name"/>
                                            <br t-if="row['line'].ref"/>
                                            <span class="bidi-text" dir="auto" t-if="row['line'].ref" t-esc="row['line'].ref"/>
                                            <br/>
                                            <span class="bidi-text" dir="auto" t-esc="row['line'].name"/>
                                        </td>
                                        <td class="date-cell"><span t-esc="row['date']"/></td>
                                        <td class="code-cell"><span t-esc="row['line'].journal_id.code"/></td>
                                        <td><span class="bidi-text" dir="auto" t-esc="row['line'].account_id.display_name"/></td>
                                        <td class="text-end">
                                            <span class="amount-cell" t-esc="row['debit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span class="amount-cell" t-esc="row['credit']"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span class="amount-cell" t-esc="row['invoice_balance']"
                                                  t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <t t-if="row['invoice'] and data['form']['include_invoice_lines']">
                                <table class="table table-sm table-bordered invoice-summary">
                                    <tbody>
                                        <tr>
                                            <td><strong t-esc="labels['invoice_total']"/></td>
                                            <td class="text-end">
                                                <span class="amount-cell" t-esc="row['invoice'].amount_total"
                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                            </td>
                                            <td><strong t-esc="labels['residual']"/></td>
                                            <td class="text-end">
                                                <span class="amount-cell" t-esc="row['invoice'].amount_residual"
                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                            </td>
                                            <td><strong t-esc="labels['payment_status']"/></td>
                                            <td><span class="bidi-text" dir="auto" t-esc="row['invoice'].payment_state"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <table class="table table-sm table-bordered lines-table">
                                    <thead>
                                        <tr>
                                            <th t-esc="labels['product_service']"/>
                                            <th class="text-end" t-esc="labels['quantity']"/>
                                            <th t-esc="labels['unit']"/>
                                            <th class="text-end" t-esc="labels['unit_price']"/>
                                            <th class="text-end" t-esc="labels['discount']"/>
                                            <th class="text-end" t-esc="labels['subtotal']"/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="not row['lines']">
                                            <td class="empty-line" colspan="6" t-esc="labels['no_invoice_lines']"/>
                                        </tr>
                                        <tr t-foreach="row['lines']" t-as="line">
                                            <td><span class="bidi-text" dir="auto" t-esc="line['name']"/></td>
                                            <td class="text-end"><span class="amount-cell" t-esc="line['quantity']"/></td>
                                            <td><span class="bidi-text" dir="auto" t-esc="line['uom']"/></td>
                                            <td class="text-end">
                                                <span class="amount-cell" t-esc="line['price_unit']"
                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                            </td>
                                            <td class="text-end"><span class="amount-cell" t-esc="line['discount']"/></td>
                                            <td class="text-end">
                                                <span class="amount-cell" t-esc="line['subtotal']"
                                                      t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-if="data['form']['include_payments'] and row['payments']">
                                <table class="table table-sm table-bordered lines-table">
                                    <thead>
                                        <tr>
                                            <th t-esc="labels['payment_settlement']"/>
                                            <th t-esc="labels['date']"/>
                                            <th t-esc="labels['journal']"/>
                                            <th t-esc="labels['reference']"/>
                                            <th class="text-end" t-esc="labels['amount']"/>
                                            <th class="text-end" t-esc="labels['balance_after']"/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="row['payments']" t-as="payment">
                                            <td><span t-esc="payment['name']"/></td>
                                            <td><span t-esc="payment['date']"/></td>
                                            <td><span t-esc="payment['journal']"/></td>
                                            <td><span t-esc="payment['ref']"/></td>
                                            <td class="text-end">
                                                <span t-esc="payment['amount']"
                                                      t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                            <td class="text-end">
                                                <span t-esc="payment['balance']"
                                                      t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                            </t>
                        </t>
                        <div style="page-break-after: always;"/>
                    </t>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
