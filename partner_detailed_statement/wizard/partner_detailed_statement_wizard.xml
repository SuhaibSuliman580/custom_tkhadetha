<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_report_partner_detailed_statement_view" model="ir.ui.view">
        <field name="name">Detailed Partner Statement</field>
        <field name="model">account.report.partner.detailed.statement</field>
        <field name="inherit_id" ref="accounting_pdf_reports.account_common_report_view"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='journal_ids']" position="before">
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_open': True, 'no_create': True}"/>
                </xpath>
                <xpath expr="//field[@name='target_move']" position="after">
                    <field name="result_selection"/>
                    <field name="include_invoice_lines"/>
                    <field name="include_payments"/>
                </xpath>
                <xpath expr="//footer/button[@name='check_report']" position="after">
                    <button name="action_xlsx" string="Excel" type="object" class="btn-secondary"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="action_account_partner_detailed_statement_menu" model="ir.actions.act_window">
        <field name="name">Detailed Partner Statement</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.report.partner.detailed.statement</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_report_partner_detailed_statement_view"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_type">report</field>
    </record>

    <menuitem id="menu_partner_detailed_statement"
              name="Detailed Partner Statement"
              sequence="6"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_account_partner_detailed_statement_menu"
              groups="account.group_account_invoice"/>

    <record id="action_partner_report_detailed_statement" model="ir.actions.act_window">
        <field name="name">Detailed Statement</field>
        <field name="res_model">account.report.partner.detailed.statement</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_report_partner_detailed_statement_view"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="context">{
            'default_partner_ids': active_ids,
            'default_target_move': 'posted',
            'default_result_selection': 'customer_supplier',
            'hide_partner': 1,
        }</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

</odoo>
